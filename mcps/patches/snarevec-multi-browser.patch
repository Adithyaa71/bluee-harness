+/* WHICH BROWSER AM I
+   ------------------
+   Several browsers can run this extension at once - Chrome, Brave, Edge, two
+   Chrome profiles - and an agent may be told to use one of them. So each
+   install keeps a random client id (one per profile, surviving restarts) and
+   reports its browser kind; the daemon gives each its own command queue, and
+   a command is only ever handed to the browser it names. */
+let browserIdentity = null;
+async function whoAmI() {
+  if (browserIdentity) return browserIdentity;
+  let { snarevecClientId: id } = await chrome.storage.local.get("snarevecClientId");
+  if (!id) {
+    id = Array.from(crypto.getRandomValues(new Uint8Array(6)),
+      (b) => b.toString(16).padStart(2, "0")).join("");
+    await chrome.storage.local.set({ snarevecClientId: id });
+  }
+  let kind = "chromium";
+  try {
+    if (navigator.brave && (await navigator.brave.isBrave())) kind = "brave";
+  } catch (_) {}
+  if (kind === "chromium") {
+    const brands = ((navigator.userAgentData && navigator.userAgentData.brands) || [])
+      .map((b) => String(b.brand).toLowerCase());
+    const ua = navigator.userAgent || "";
+    if (brands.some((b) => b.includes("edge")) || /Edg\//.test(ua)) kind = "edge";
+    else if (brands.some((b) => b.includes("brave"))) kind = "brave";
+    else if (brands.some((b) => b.includes("opera")) || /OPR\//.test(ua)) kind = "opera";
+    else if (brands.some((b) => b.includes("vivaldi"))) kind = "vivaldi";
+    else if (brands.some((b) => b.includes("google chrome"))) kind = "chrome";
+  }
+  browserIdentity = { client_id: id, kind };
+  return browserIdentity;
+}
