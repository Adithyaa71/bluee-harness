# Copy to .env and fill in. .env is gitignored.
#
# The provider is any OpenAI-compatible endpoint (§3). That covers both the
# current aicredits.in setup and the eventual OpenRouter move - switching is a
# change to these three lines, not to any code.

# Interim: aicredits.in
LLM_BASE_URL=https://aicredits.in/v1
LLM_API_KEY=
LLM_MODEL=

# Eventual: OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3-30b-a3b

# Run `cargo run -- models` to list what the configured provider actually
# offers, and copy the exact id into LLM_MODEL. Do not guess the id.
