# Build output (redirected to D:/tgt/harness via .cargo/config.toml, but keep
# this in case the override is ever removed)
/target/

# Python env for the MCP tool servers (UACC, SnareVec, the kuzu graph server)
.venv/
__pycache__/
*.pyc

# Runtime state. data/events is the source of truth (§4a) and is deliberately
# NOT committed - it is personal session content, and it is regenerated by use.
# The derived layers below are rebuildable from it by definition.
/data/

# Embedding model downloaded on first use by fastembed (~86 MB of ONNX blobs).
# A cache, not source - it re-downloads if absent.
/.fastembed_cache/

# Generated by tauri-build on every compile.
/gen/

# Secrets
.env

# Cloned repos that carry their own git history:
#   mcps/UACC, reference/RustFox, reference/friday-tony-stark-demo
/mcps/UACC/
/reference/
